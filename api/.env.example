PORT=8080
ODOO_URL=http://localhost:8069
ODOO_DB=makip
# json2 (Odoo 19+) o jsonrpc
ODOO_API_MODE=json2
ODOO_API_USER=api_catalogo
# Clave de API del usuario técnico (Preferencias > Seguridad de la cuenta > Nueva clave de API)
ODOO_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
CACHE_TTL_MS=300000
# Dominio opcional en JSON, p. ej. limitar a una categoría:
# CATALOG_DOMAIN=[["sale_ok","=",true],["categ_id.name","=","Llaveros"]]
