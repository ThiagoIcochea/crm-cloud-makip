#!/bin/bash
# Arranque de la VM de Odoo (generado por Terraform). Idempotente.
set -euo pipefail

if ! command -v docker >/dev/null; then
  apt-get update -y
  apt-get install -y ca-certificates curl git
  curl -fsSL https://get.docker.com | sh
fi

mkdir -p /opt/makip
cd /opt/makip
if [ ! -d repo ]; then
  git clone --depth 1 "${repository_url}" repo
fi
cd repo/app

DB_PASSWORD=$(gcloud secrets versions access latest --secret="${db_secret}")

cat > .env <<ENV
ODOO_VERSION=${odoo_version}
DB_HOST=${db_host}
DB_PORT=5432
DB_NAME=${db_name}
DB_USER=odoo
DB_PASSWORD=$DB_PASSWORD
BACKOFFICE_DOMAIN=${domain}
ENV
chmod 600 .env

COMPOSE="docker compose -f docker-compose.yml -f docker-compose.gcp.yml"

# Primera vez: crear la base e instalar los módulos estándar del MVP
if [ ! -f /opt/makip/.odoo-initialized ]; then
  $COMPOSE run --rm odoo odoo -d ${db_name} -i base,contacts,crm,sale_management --stop-after-init \
    && touch /opt/makip/.odoo-initialized
fi

# Nginx necesita el certificado TLS (ver docs/runbook.md); Odoo arranca aunque Nginx espere.
$COMPOSE up -d odoo
$COMPOSE up -d nginx || true
